{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.tmp/ui",
    "tsBuildInfoFile": "./node_modules/.tmp/ui.tsbuildinfo",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/ui.tsx", "src/App.tsx", "src/messages.ts"]
}
