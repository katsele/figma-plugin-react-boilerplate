{
  "name": "figma-plugin-boilerplate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n plugin,ui -c blue,green \"npm:dev:plugin\" \"npm:dev:ui\"",
    "dev:plugin": "vite build --mode plugin --watch",
    "dev:ui": "vite build --mode ui --watch",
    "build": "npm run build:plugin && npm run build:ui",
    "build:plugin": "vite build --mode plugin",
    "build:ui": "vite build --mode ui",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.114.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
