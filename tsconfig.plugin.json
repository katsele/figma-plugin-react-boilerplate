{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.tmp/plugin",
    "tsBuildInfoFile": "./node_modules/.tmp/plugin.tsbuildinfo",
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@figma/plugin-typings"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/main.ts", "src/messages.ts"]
}
